# Optional: private Outlook ICS URL (credential — never commit the real value).
# Prefer pasting the link in the app under Settings → Outlook calendar link.
# CALENDAR_ICS_URL is only a fallback if nothing is saved in the app.
CALENDAR_ICS_URL=

# Optional OpenAI-compatible LLM for richer natural-language task parsing
# If unset, the built-in deterministic parser is used.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
